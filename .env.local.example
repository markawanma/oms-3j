# Copy to .env.local (gitignored) and fill in real values.
# Never commit real keys — this file only holds placeholders (CLAUDE.md hard rule).
#
# Get these from: Supabase project "3J Online Sale" -> Settings -> API.

# --- Client-side (safe to expose — NEXT_PUBLIC_ is bundled into the browser) ---
# NOTE (documented limitation): this MVP's RLS policies (0002_rls.sql) all
# require `auth.uid()` to resolve to a row in shop_member. There is no
# auth/onboarding UI yet (see design doc + CLAUDE.md), so a real end-user
# session that would make anon-key + RLS reads succeed does not exist in this
# batch. These two vars are wired up for when auth ships, but every page in
# this app currently reads/writes through server actions using the service
# role key + a fixed DEV_SHOP_ID instead (see lib/dev/context.ts). Do not
# build client-side Supabase queries against these yet — they will return
# empty results (RLS default-deny) until a real authenticated shop_member
# exists.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server-only — NEVER prefix with NEXT_PUBLIC_, never sent to the browser ---
# Same value as NEXT_PUBLIC_SUPABASE_URL is fine here; kept separate so
# server code never accidentally depends on the NEXT_PUBLIC_ var.
SUPABASE_URL=
# service_role key — bypasses RLS entirely. Required for the RPCs
# (reserve_stock/commit_stock/release_stock/adjust_stock) which are
# service_role-only (see supabase/migrations/0006), and for this MVP's
# dev-only server actions (orders/stock/products) which read+write directly
# with an explicit shop_id filter in place of the RLS this key bypasses.
SUPABASE_SERVICE_ROLE_KEY=

# --- Dev-only auth shortcut (see docs/phase1-design.md limitation + CLAUDE.md) ---
# There is no login yet. Every page in this app operates as if the current
# user belongs to exactly this one shop. Seed one shop + sample products via
# SQL (see docs/dev-seed.sql, or run the equivalent INSERT manually against
# your Supabase project), copy its `shop.id`, and paste it here.
# THIS MUST BE REPLACED BY REAL AUTH (Supabase Auth + shop_member) BEFORE ANY
# REAL USER OTHER THAN THE DEV TEAM TOUCHES THIS APP.
DEV_SHOP_ID=

# --- Dev-only role shortcut (see lib/dev/context.ts getDevRole) ---
# Stand-in for shop_member.role until real auth ships.
# Values: owner | admin | staff. Anything else (including unset) = "staff"
# — fail closed on purpose.
#
# WHAT IT GATES (grew past PII — check before changing):
#   - CRM customer-360 PII section (phone/name/address)   [hidden on staff]
#   - /dashboard money figures via p_include_money         [hidden on staff, page still usable]
#   - /tiktok/dashboard ENTIRE PAGE                        [BLOCKED on staff — 0070/0071]
#
# That last one is why the default here is `owner`, not `staff`: the shop
# currently runs a single permission level ("everyone is the owner"), so a
# forgotten DEV_ROLE would lock the owner out of their own TikTok dashboard
# rather than protect anyone. Set to `staff` only when you are deliberately
# testing the restricted view.
#
# NOT REAL SECURITY: this is a TypeScript `if`, and every server action reads
# through the service-role client, which bypasses RLS. Once Supabase Auth
# lands (A2), a staff user can hit PostgREST directly and read
# analytics.fact_order — revenue and profit included — without touching any
# of these checks. Role rules that must actually hold have to live in RLS on
# the table, not in an `if` in the action.
DEV_ROLE=owner

# --- Silver price — Google Sheets API (scripts/capture-silver-price-sheet.mjs) ---
# 2026-09-02: replaced the old "publish to web" public CSV link
# (SILVER_SHEET_CSV_URL, now removed) with Google Sheets API v4 read via a
# service account (JWT bearer, node:crypto — no googleapis dependency). The
# old public link let anyone with the URL download the ENTIRE tab (cost,
# margin, block fee — not just the price columns shown on the website) and
# had already been committed to a public repo once. Do not reintroduce a
# public-link fallback.
#
# Path to the service-account key JSON file — must live OUTSIDE this repo.
# Get it from Google Cloud Console > IAM & Admin > Service Accounts > Keys >
# Add key > JSON. Then open the sheet in Google Sheets, click Share, and
# grant that service account's client_email Viewer access (scope requested
# is spreadsheets.readonly, so Viewer is enough).
# ⚠️ Use FORWARD slashes even on Windows. `node --env-file` treats a backslash
# as an escape, so C:\Users\... silently becomes garbage and you get an ENOENT
# for a path you never typed (cost 10 minutes on 2026-09-02).
#   right: C:/Users/Someone/.3j-secrets/sheets-key.json
#   wrong: C:\Users\Someone\.3j-secrets\sheets-key.json
# Keep the file OUTSIDE this repo — it holds a real private key.
GOOGLE_SERVICE_ACCOUNT_KEY_FILE=
# Spreadsheet ID (the long id in the sheet's URL between /d/ and /edit).
SILVER_SHEET_ID=
# A1 notation range covering the price tables.
# ⚠️ A tab name needs single quotes in A1 notation, and `node --env-file` eats
# a value that STARTS with a quote (it reads 'ราคา' and drops the rest, leaving
# just the tab name with no range). Wrap the whole thing in double quotes:
#   right: SILVER_SHEET_RANGE="'ราคา'!A1:Z80"
#   wrong: SILVER_SHEET_RANGE='ราคา'!A1:Z80
SILVER_SHEET_RANGE=
