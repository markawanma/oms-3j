# Copy to .env.test (gitignored) or export these directly in your shell before
# running the central-stock RPC integration suite in supabase/tests/.
#
# These are LOCAL DEV values only — never put a hosted/production project's
# service_role key here or in any committed file (CLAUDE.md hard rule: no
# hardcoded secrets). Get local values by running, in a separate terminal:
#   supabase start
#   supabase status -o env
#
# SUPABASE_URL usually defaults to http://127.0.0.1:54321 for local dev.

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional — only enables one bonus regression test (privilege guard) in
# supabase/tests/stock-validation.test.ts. Safe to leave blank.
SUPABASE_ANON_KEY=
