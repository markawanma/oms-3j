# Copy to .env.test.local (gitignored) or export these directly in your shell before
# running the central-stock RPC integration suite in supabase/tests/ (`npm run test:db`).
#
# ⚠️ โปรเจกต์นี้มี DB เดียว (ไม่มี dev/prod แยก) — ชุดทดสอบนี้เขียนแถวจริงลง DB ที่ชี้ไป
# (ร้านทดสอบ "QA Test Shop <uuid>" + สต็อก/ออเดอร์ของมัน) แล้วลบตอน teardown
# ถ้า suite ตายกลางทาง ร้านทดสอบจะค้างใน DB จริง ต้องเก็บกวาดมือด้วย shop id ที่พิมพ์ใน error
#
# ทางที่ปลอดภัยกว่า: local DB (`supabase start` → `supabase status -o env`)
#   SUPABASE_URL=http://127.0.0.1:54321 · TEST_DB_ADMIN_URL ชี้ 127.0.0.1 → รันได้เลย
# ทางที่เรามีจริงตอนนี้: ชี้ DB ที่ใช้ร่วมกัน → ต้องตั้ง ALLOW_SHARED_DB_TEARDOWN=1 เอง "ทุกครั้งที่รัน"
#   (ห้ามใส่ไว้ในไฟล์นี้หรือไฟล์ env ใดๆ — ตั้งใจให้ต้องพิมพ์ทุกครั้ง) เช่น
#   ALLOW_SHARED_DB_TEARDOWN=1 npm run test:db      (Windows PowerShell: $env:ALLOW_SHARED_DB_TEARDOWN='1'; npm run test:db)
#
# ห้ามใส่ค่าจริงของ hosted/production project ในไฟล์ที่ commit (CLAUDE.md: no hardcoded secrets) —
# ไฟล์นี้เป็นแม่แบบเปล่าเท่านั้น ค่าจริงอยู่ .env.test.local / .env.test (ทั้งคู่ gitignored)
#
# ถ้าตั้ง SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY แต่ไม่ตั้ง TEST_DB_ADMIN_URL → suite ถูกข้าม (skip) พร้อมคำเตือน ไม่ใช่ error

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional — only enables one bonus regression test (privilege guard) in
# supabase/tests/stock-validation.test.ts. Safe to leave blank.
SUPABASE_ANON_KEY=

# ใช้ลบร้านทดสอบตอน teardown — connection string ของเจ้าของตาราง (postgres) ของ DB เดียวกับ SUPABASE_URL
# 0161 ถอนสิทธิ์ DELETE บน public.shop จาก service_role แล้ว จึงลบผ่าน SUPABASE_SERVICE_ROLE_KEY ไม่ได้
# รหัสผ่านที่มีอักขระพิเศษต้อง URL-encode · helper ปฏิเสธ host ที่ไม่ใช่ localhost/127.0.0.1 ถ้าไม่ตั้ง ALLOW_SHARED_DB_TEARDOWN=1
# guard ตอนลบ (ทุกข้อต้องจริงพร้อมกัน ไม่งั้นหยุดก่อนลบอะไร): ชื่อร้านขึ้นต้น "QA Test Shop " · สร้างมาไม่เกิน 1 ชั่วโมง · ล็อกแถวร้านด้วย for update
TEST_DB_ADMIN_URL=

# ALLOW_SHARED_DB_TEARDOWN=   # ← ตั้งใจคอมเมนต์ไว้ ห้ามเปิดในไฟล์
